{
  "name": "whelp-of-warcraft",
  "version": "0.3.1",
  "private": true,
  "description": "World-data Hub for Encounters, Loadouts & Progression",
  "scripts": {
    "test": "npm run validate && npm run lint:lua && npm run test:tools",
    "validate": "node tools/validate.mjs",
    "lint:lua": "node tools/check-lua.mjs",
    "test:tools": "node --test tools/tests/*.test.mjs",
    "import:mdt": "node tools/import-mdt.mjs",
    "import:season-mdt": "node tools/import-season-mdt.mjs",
    "inspect:mdt-packs": "node tools/inspect-mdt-packs.mjs",
    "generate:addon-knowledge": "node tools/generate-addon-knowledge.mjs",
    "generate:ability-index": "node tools/generate-ability-index.mjs",
    "query:abilities": "node tools/query-abilities.mjs",
    "query:responses": "node tools/query-ability-responses.mjs",
    "query:spec-responses": "node tools/query-spec-responses.mjs",
    "import:savedvariables": "node tools/import-savedvariables.mjs",
    "compare:route": "node tools/compare-run-to-route.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "fengari": "0.1.5",
    "luaparse": "0.3.1"
  }
}
