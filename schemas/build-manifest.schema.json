{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whelp.dev/schemas/build-manifest.schema.json",
  "title": "WHELP build manifest",
  "type": "object",
  "required": ["schemaVersion", "recordType", "product", "version", "interfaceVersion", "observedAt", "provenance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "build-manifest" },
    "product": { "type": "string", "minLength": 1 },
    "region": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "interfaceVersion": { "type": "integer", "minimum": 1 },
    "observedAt": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "provenance.schema.json" }
    }
  },
  "additionalProperties": false
}
