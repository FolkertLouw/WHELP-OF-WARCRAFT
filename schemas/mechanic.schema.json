{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whelp.dev/schemas/mechanic.schema.json",
  "title": "WHELP mechanic",
  "type": "object",
  "required": ["schemaVersion", "recordType", "id", "status", "validity", "encounter", "mechanic", "provenance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "mechanic" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./_-]+$" },
    "status": { "enum": ["draft", "verified", "deprecated"] },
    "validity": { "$ref": "validity.schema.json" },
    "encounter": {
      "type": "object",
      "required": ["instanceId", "encounterId"],
      "properties": {
        "instanceId": { "type": "integer", "minimum": 1 },
        "encounterId": { "type": "integer", "minimum": 1 },
        "npcId": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "mechanic": {
      "type": "object",
      "required": ["spellId", "category", "summary"],
      "properties": {
        "spellId": { "type": "integer", "minimum": 1 },
        "category": { "enum": ["interrupt", "dispel", "defensive", "movement", "positioning", "control", "damage", "healing", "other"] },
        "summary": { "type": "string", "minLength": 1 },
        "response": { "type": "string" }
      },
      "additionalProperties": false
    },
    "roles": { "type": "array", "items": { "enum": ["tank", "healer", "damage"] }, "uniqueItems": true },
    "specIds": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
    "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "provenance.schema.json" } }
  },
  "additionalProperties": false
}
