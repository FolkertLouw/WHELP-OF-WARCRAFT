{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whelp.dev/schemas/route-catalog.schema.json",
  "title": "WHELP season route catalog",
  "type": "object",
  "required": ["schemaVersion", "recordType", "id", "status", "validity", "seasonSlug", "scope", "entries", "provenance"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "route-catalog" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./_-]+$" },
    "status": { "enum": ["draft", "verified", "deprecated"] },
    "validity": { "$ref": "validity.schema.json" },
    "seasonSlug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "scope": {
      "type": "object",
      "required": ["routeKind", "minimumKey", "maximumKey"],
      "properties": {
        "routeKind": { "enum": ["learning", "pug", "push", "farm", "experimental"] },
        "minimumKey": { "type": "integer", "minimum": 2 },
        "maximumKey": { "type": "integer", "minimum": 2 }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dungeonId", "routeId", "routeStatus", "requiredEnemyForces", "plannedEnemyForces", "surplusEnemyForces", "pullCount", "bossCheckpointCount", "sourceMappingStatus", "normalizationStatus", "caveats"],
        "properties": {
          "dungeonId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
          "routeId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./_-]+$" },
          "routeStatus": { "enum": ["draft", "verified", "deprecated"] },
          "requiredEnemyForces": { "type": "integer", "minimum": 1 },
          "plannedEnemyForces": { "type": "integer", "minimum": 1 },
          "surplusEnemyForces": { "type": "integer", "minimum": 0 },
          "pullCount": { "type": "integer", "minimum": 1 },
          "bossCheckpointCount": { "type": "integer", "minimum": 0 },
          "sourceMappingStatus": { "enum": ["not-flagged", "older", "unknown"] },
          "normalizationStatus": { "enum": ["direct", "reconciled", "conflicted"] },
          "caveats": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    },
    "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "provenance.schema.json" } }
  },
  "additionalProperties": false
}
