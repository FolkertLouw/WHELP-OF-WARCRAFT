{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whelp.dev/schemas/strategy-note.schema.json",
  "title": "WHELP strategy note",
  "type": "object",
  "required": ["schemaVersion", "recordType", "id", "status", "validity", "context", "category", "summary", "actions", "provenance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "strategy-note" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./_-]+$" },
    "status": { "enum": ["draft", "corroborated", "verified", "deprecated"] },
    "validity": { "$ref": "validity.schema.json" },
    "context": {
      "type": "object",
      "required": ["contentType", "instanceMapId"],
      "properties": {
        "contentType": { "const": "mythic-plus" },
        "instanceMapId": { "type": "integer", "minimum": 1 },
        "encounterId": { "type": ["integer", "null"], "minimum": 1 },
        "npcIds": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
        "spellIds": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "category": { "enum": ["interrupt", "dispel", "control", "positioning", "route", "profession", "encounter", "other"] },
    "summary": { "type": "string", "minLength": 1 },
    "actions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "roles": { "type": "array", "items": { "enum": ["tank", "healer", "damage"] }, "uniqueItems": true },
    "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "provenance.schema.json" } }
  },
  "additionalProperties": false
}
