{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whelp.dev/schemas/run-observation.schema.json",
  "title": "WHELP run observation",
  "type": "object",
  "required": ["schemaVersion", "recordType", "collector", "game", "run", "encounters", "player", "group", "privacy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "run-observation" },
    "collector": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "WHELP Collector" },
        "version": { "type": "string" },
        "knowledgeBuild": { "type": ["string", "null"] },
        "knowledgeRevision": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "game": {
      "type": "object",
      "required": ["version", "build", "interfaceVersion"],
      "properties": {
        "version": { "type": "string" },
        "build": { "type": "string" },
        "interfaceVersion": { "type": "integer", "minimum": 1 },
        "region": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": ["challengeMapId", "keystoneLevel", "startedAt", "status"],
      "properties": {
        "challengeMapId": { "type": "integer", "minimum": 1 },
        "routePlanId": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9./_-]+$" },
        "keystoneLevel": { "type": "integer", "minimum": 2 },
        "affixIds": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "startedAt": { "type": "integer", "minimum": 1 },
        "completedAt": { "type": ["integer", "null"], "minimum": 1 },
        "durationMs": { "type": ["integer", "null"], "minimum": 0 },
        "deathCount": { "type": "integer", "minimum": 0 },
        "deathTimeLostMs": { "type": "integer", "minimum": 0 },
        "recoveryCount": { "type": "integer", "minimum": 0 },
        "telemetryGapCount": { "type": "integer", "minimum": 0 },
        "lastRecoveredAt": { "type": ["integer", "null"], "minimum": 1 },
        "pullDataStatus": { "enum": ["progress-only", "build-mismatch", "dungeon-unknown", "knowledge-unavailable"] },
        "terminationReason": { "enum": ["challenge-completed", "challenge-reset", "superseded-by-new-run", "recovery-no-matching-challenge"] },
        "status": { "enum": ["started", "completed", "abandoned"] }
      },
      "additionalProperties": false
    },
    "encounters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["encounterId", "startedAt", "completedAt", "durationMs", "success"],
        "properties": {
          "encounterId": { "type": "integer", "minimum": 1 },
          "startedAt": { "type": "integer", "minimum": 1 },
          "completedAt": { "type": "integer", "minimum": 1 },
          "durationMs": { "type": "integer", "minimum": 0 },
          "success": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "pulls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["order", "startedAt", "completedAt", "durationMs", "enemies", "enemyForces", "deaths"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "plannedPullId": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]+$" },
          "startedAt": { "type": "integer", "minimum": 1 },
          "completedAt": { "type": ["integer", "null"], "minimum": 1 },
          "durationMs": { "type": ["integer", "null"], "minimum": 0 },
          "enemies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["npcId", "count"],
              "properties": {
                "npcId": { "type": "integer", "minimum": 1 },
                "count": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          },
          "enemyForces": { "type": "integer", "minimum": 0 },
          "enemyForcesSource": { "enum": ["scenario-progress", "canonical-npc-sum", "unavailable"] },
          "enemyForcesStart": { "type": ["integer", "null"], "minimum": 0 },
          "enemyForcesEnd": { "type": ["integer", "null"], "minimum": 0 },
          "enemyIdentityStatus": { "enum": ["available", "unavailable-secret-values"] },
          "endReason": { "enum": ["combat-ended", "reload-reconciled", "run-ended"] },
          "deaths": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "player": { "$ref": "player.schema.json" },
    "group": { "type": "array", "items": { "$ref": "player.schema.json" }, "maxItems": 5 },
    "privacy": {
      "type": "object",
      "required": ["containsNames", "containsChat"],
      "properties": {
        "containsNames": { "const": false },
        "containsChat": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
