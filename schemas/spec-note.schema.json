{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whelp.dev/schemas/spec-note.schema.json",
  "title": "WHELP specialization note",
  "type": "object",
  "required": ["schemaVersion", "recordType", "id", "status", "validity", "context", "specIds", "summary", "recommendations", "provenance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "spec-note" },
    "id": { "type": "string" },
    "status": { "enum": ["draft", "corroborated", "verified", "deprecated"] },
    "validity": { "$ref": "validity.schema.json" },
    "context": {
      "type": "object",
      "required": ["contentType"],
      "properties": {
        "contentType": { "enum": ["mythic-plus", "raid", "delve", "open-world"] },
        "instanceMapId": { "type": ["integer", "null"], "minimum": 1 },
        "encounterId": { "type": ["integer", "null"], "minimum": 1 },
        "keyLevelMinimum": { "type": ["integer", "null"], "minimum": 2 },
        "keyLevelMaximum": { "type": ["integer", "null"], "minimum": 2 }
      },
      "additionalProperties": false
    },
    "specIds": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
    "summary": { "type": "string", "minLength": 1 },
    "recommendations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "provenance.schema.json" } }
  },
  "additionalProperties": false
}
