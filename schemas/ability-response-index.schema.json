{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whelp.dev/schemas/ability-response-index.schema.json",
  "title": "WHELP curated ability response index",
  "type": "object",
  "required": ["schemaVersion", "recordType", "id", "status", "validity", "seasonSlug", "entries", "provenance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "ability-response-index" },
    "id": { "type": "string" },
    "status": { "enum": ["draft", "corroborated", "verified", "deprecated"] },
    "validity": { "$ref": "validity.schema.json" },
    "seasonSlug": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dungeonId", "recordId", "path", "status"],
        "properties": {
          "dungeonId": { "type": "string" },
          "recordId": { "type": "string" },
          "path": { "type": "string" },
          "status": { "enum": ["draft", "corroborated", "verified", "deprecated"] }
        },
        "additionalProperties": false
      }
    },
    "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "provenance.schema.json" } }
  },
  "additionalProperties": false
}
