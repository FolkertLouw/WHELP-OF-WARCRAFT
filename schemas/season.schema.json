{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whelp.dev/schemas/season.schema.json",
  "title": "WHELP season",
  "type": "object",
  "required": ["schemaVersion", "recordType", "id", "status", "expansion", "seasonNumber", "validity", "dungeons", "provenance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "season" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "status": { "enum": ["draft", "corroborated", "verified", "deprecated"] },
    "expansion": { "type": "string", "minLength": 1 },
    "seasonNumber": { "type": "integer", "minimum": 1 },
    "validity": { "$ref": "validity.schema.json" },
    "startsAt": { "type": ["string", "null"], "format": "date-time" },
    "dungeons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "challengeMapId", "expansion"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "challengeMapId": { "type": "integer", "minimum": 1 },
          "expansion": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "provenance.schema.json" } }
  },
  "additionalProperties": false
}
