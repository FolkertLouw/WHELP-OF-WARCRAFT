{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whelp.dev/schemas/spec-capabilities.schema.json",
  "title": "WHELP specialization capabilities",
  "type": "object",
  "required": ["schemaVersion", "recordType", "id", "status", "validity", "spec", "tools", "provenance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "spec-capabilities" },
    "id": { "type": "string" },
    "matrixRecordId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "corroborated", "verified", "deprecated"] },
    "validity": { "$ref": "validity.schema.json" },
    "spec": {
      "type": "object",
      "required": ["classId", "className", "specId", "specName", "slug"],
      "properties": {
        "classId": { "type": "integer", "minimum": 1 },
        "className": { "type": "string" },
        "specId": { "type": "integer", "minimum": 1 },
        "specName": { "type": "string" },
        "slug": { "type": "string" }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "spellId", "actions", "availability", "scope", "limitations"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "spellId": { "type": "integer", "minimum": 1 },
          "actions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["interrupt", "purge", "cleanse-magic", "cleanse-curse", "cleanse-disease", "cleanse-poison", "soothe", "defensive", "crowd-control", "external-defensive", "battle-resurrection", "party-damage-reduction", "bloodlust"] } },
          "alternateSpellIds": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
          "availability": { "enum": ["baseline", "specialization", "talent"] },
          "actionAvailability": {
            "type": "object",
            "propertyNames": { "enum": ["interrupt", "purge", "cleanse-magic", "cleanse-curse", "cleanse-disease", "cleanse-poison", "soothe", "defensive", "crowd-control", "external-defensive", "battle-resurrection", "party-damage-reduction", "bloodlust"] },
            "additionalProperties": { "enum": ["baseline", "specialization", "talent"] }
          },
          "scope": { "enum": ["enemy", "friendly-single", "friendly-periodic-area", "friendly-area", "self", "area-enemy"] },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "value"],
              "properties": {
                "kind": { "enum": ["pet-specialization", "faction", "talent", "equipment", "configuration"] },
                "value": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "limitations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    },
    "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "provenance.schema.json" } }
  },
  "additionalProperties": false
}
