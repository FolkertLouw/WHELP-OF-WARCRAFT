{
  "$schema": "schemas/dataset-manifest.schema.json",
  "schemaVersion": 1,
  "name": "WHELP-OF-WARCRAFT",
  "acronym": "World-data Hub for Encounters, Loadouts & Progression",
  "datasetVersion": "0.7.0",
  "currentBuild": "12.1.0.69587",
  "currentSeason": "midnight-season-2",
  "entrypoints": {
    "agentBriefing": "AGENTS.md",
    "canonicalData": "data/index.json",
    "strategyKnowledge": "content/index.json",
    "flaggedAbilities": "data/abilities/midnight-season-2.json",
    "curatedAbilityResponses": "content/mythic-plus/midnight-season-2/abilities/response-index.json",
    "specCapabilities": "data/index.json",
    "specCapabilityCoverage": "data/specs/coverage.json",
    "sourceFreshnessPolicy": "data/policies/source-freshness.json",
    "pugRoutes": "content/mythic-plus/midnight-season-2/routes/catalog.json",
    "trustModel": "docs/TRUST_MODEL.md"
  },
  "commands": {
    "validate": "npm test",
    "queryAbilities": "npm run query:abilities -- --dungeon <id> --tag <response-tag>",
    "queryAbilityResponses": "npm run query:responses -- --dungeon <id> --action <action> --priority <priority>",
    "querySpecResponses": "npm run query:spec-responses -- --spec <spec-slug> --dungeon <id> --coverage <full|partial|none>",
    "queryCapabilities": "npm run query:capabilities -- --specs <spec-slug,spec-slug> --action <action>",
    "querySpecMatrix": "npm run query:spec-matrix -- --spec <spec-slug> --dungeon <id> --affix <slug> --rating <always|niche|none>",
    "queryMatrixCoverage": "npm run query:matrix-coverage",
    "queryLoadout": "npm run query:loadout -- --spec <spec-slug> --dungeon <id>",
    "queryPartyGaps": "npm run query:party-gaps -- --specs <spec-slug,spec-slug> --dungeon <id>",
    "queryFreshness": "npm run query:freshness -- --as-of <ISO-date> --include <review|all>",
    "regenerateAbilityIndex": "npm run generate:ability-index"
  }
}
